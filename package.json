{
  "name": "enodia",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "description": "In-run build companion for Hades II",
  "author": "Stigsmith",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate.ts && node scripts/build-app-data.ts",
    "build": "vite build && node scripts/prune.ts",
    "preview": "vite preview",
    "validate": "node scripts/validate.ts",
    "extract": "node scripts/extract.mjs",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "assets": "node scripts/assets.ts",
    "banners": "node scripts/banners.ts",
    "portraits": "node scripts/portraits.ts",
    "data": "node scripts/build-app-data.ts",
    "sprites": "node scripts/sprites.ts",
    "chrome": "node scripts/chrome.ts",
    "reward-frame": "node scripts/reward-frame.ts",
    "health": "node scripts/health.ts",
    "prune": "node scripts/prune.ts",
    "lite": "node scripts/lite.ts",
    "artifact": "node scripts/artifact.ts",
    "fonts": "node scripts/fonts.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:schema": "node scripts/db-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply enodia --local",
    "types": "wrangler types",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
