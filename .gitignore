# Scratch. deppth2 output from the game packages, 443 MB and regenerable.
# Re-create with the deppth2 commands in assets/README.md.
extracted/

# The owner's reference art for the mascot work. Not regenerable: none of it is
# a byte copy of anything in extracted/. Anchored to the root, because the
# unanchored pattern also hid assets/reference/, and scripts/assets.ts put those
# files in the committed manifest. Every clean clone then failed the build.
/reference/

node_modules/

# Build output, written by `npm run build`.
dist/

# wrangler dev's local state and asset cache. Not all of it regenerates: the
# local D1 is under state/v3/d1, and deleting it loses every row in it.
# `npm run db:migrate` brings back the tables and nothing else. The local seed
# scripts for it sit at the top of the folder.
.wrangler/
# `npm run artifact` output: one self contained HTML file, rebuildable.
dist-artifact/

*.local
.DS_Store
Thumbs.db

# Exports. Somebody's whole library, written by the settings screen. It is
# personal data and it is never this repository's to carry.
enodia-*.json

# wrangler dev secrets. Production uses `wrangler secret put`.
.dev.vars
.dev.vars.*
