# Scratch. deppth2 output from the game packages, 443 MB and regenerable.
# Re-create with the deppth2 commands in assets/README.md.
extracted/

# Reference art pulled for the mascot work. Regenerable from extracted/.
reference/

node_modules/

# Build output. Vite owns dist/ now.
# The hand-authored page that used to live here is placeholder/index.html, still
# in version control and still what Netlify is serving until `npm run deploy`
# puts the real app on Cloudflare.
# Serve it on 8777 with the `placeholder` config in .claude/launch.json.
dist/

# wrangler dev's local state and asset cache. Regenerated on every run.
.wrangler/
# `npm run artifact` output: one self contained HTML file, rebuildable.
dist-artifact/

*.local
.DS_Store
Thumbs.db

# Exports. Somebody's whole library, written by the settings screen. It is
# personal data and it is never this repository's to carry.
enodia-*.json

# wrangler dev secrets. Production uses `wrangler secret put`.
.dev.vars
.dev.vars.*
